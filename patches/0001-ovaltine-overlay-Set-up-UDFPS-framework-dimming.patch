From ac9b62436bdbe9a41f7bf50257adcc779689b797 Mon Sep 17 00:00:00 2001
From: dekefake <desathomas@gmail.com>
Date: Sun, 20 Aug 2023 18:22:08 +0000
Subject: [PATCH] ovaltine: overlay: Set up UDFPS framework dimming

Change-Id: I438f770c6a8ee08ddc2c7cdfc55218f3987e75c7
---
 .../res/values/config.xml                     | 64 +++++++++++++++++++
 1 file changed, 64 insertions(+)
 create mode 100644 overlay/OPlusSystemUIResTarget/res/values/config.xml

diff --git a/overlay/OPlusSystemUIResTarget/res/values/config.xml b/overlay/OPlusSystemUIResTarget/res/values/config.xml
new file mode 100644
index 0000000..21d3d59
--- /dev/null
+++ b/overlay/OPlusSystemUIResTarget/res/values/config.xml
@@ -0,0 +1,64 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     Copyright (C) 2023 The LineageOS Project
+     SPDX-License-Identifier: Apache-2.0
+-->
+<resources>
+
+    <!-- Whether to enable framework dimming for UDFPS -->
+    <bool name="config_udfpsFrameworkDimming">true</bool>
+
+    <!-- Array of brightness-alpha LUT for framework dimming -->
+    <string-array name="config_udfpsDimmingBrightnessAlphaArray" translatable="false">
+          <item>0,250</item>
+          <item>1,232</item>
+          <item>2,223</item>
